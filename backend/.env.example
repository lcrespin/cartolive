# =============================================================================
# breathe.live — backend configuration
# Copy this file to .env and edit any value. All keys below are read at startup.
# =============================================================================

# --- Server ------------------------------------------------------------------
PORT=3001
HOST=0.0.0.0

# --- API keys ----------------------------------------------------------------
# OpenSky: https://opensky-network.org → Account → API client (OAuth2).
# Leave both empty for anonymous access (lower rate limit).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# AISstream: https://aisstream.io — required for live boats.
AISSTREAM_API_KEY=

# Impact CO2 (ADEME Base Empreinte): optional Bearer key for `npm run refresh:co2-factors` only.
# Runtime reads backend/data/co2-factors.snapshot.json — not the live API.
IMPACT_CO2_API_KEY=

# When refreshing the snapshot: maritime/AIS is not in Impact CO2 /api/v1/transport.
# Set a Base Empreinte passenger·km factor (g CO₂e / pax·km) to bake into the snapshot:
# IMPACT_CO2_BOAT_G_PER_PASSENGER_KM=18.7
# IMPACT_CO2_BOAT_ADEME_LABEL=Ferry passager (Base Empreinte ADEME)

# --- SNCF trains -------------------------------------------------------------
# Trip updates + static GTFS stops → approximate positions (next stop).
SNCF_GTFS_RT_URL=https://proxy.transport.data.gouv.fr/resource/sncf-gtfs-rt-trip-updates
SNCF_GTFS_STATIC_URL=https://eu.ftp.opendatasoft.com/sncf/plandata/Export_OpenData_SNCF_GTFS_NewTripId.zip

# --- IDFM buses & metro (Paris) ----------------------------------------------
# Set IDFM_GTFS_RT_URL to a real VehiclePositions feed if you have one.
# Leave empty to use trip updates + stop coordinates (approximate next-stop).
IDFM_GTFS_RT_URL=
IDFM_TRIP_UPDATES_URL=http://gtfsidfm.clarifygdps.com/gtfs-rt-trips-idfm
IDFM_STOPS_URL=https://data.iledefrance-mobilites.fr/api/explore/v2.1/catalog/datasets/arrets-lignes/exports/csv

# --- Extra-city buses (GTFS-RT VehiclePositions) -----------------------------
# JSON array: { "id", "prefix", "url" } per city. Merged into hub type "bus"
# with prefixes so they do not collide with IDFM (idfm-).
# Feeds that 404 or return 0 positions are skipped (see /api/health).
GTFS_RT_FEEDS=[{"id":"lyon","prefix":"lyon-","url":"https://proxy.transport.data.gouv.fr/resource/tcl-lyon-gtfs-rt-vehicle-position"},{"id":"marseille","prefix":"mrs-","url":"https://proxy.transport.data.gouv.fr/resource/rtm-marseille-gtfs-rt-vehicle-position"},{"id":"toulouse","prefix":"tls-","url":"https://api.tisseo.fr/opendata/gtfsrt/GtfsRt.pb"},{"id":"bordeaux","prefix":"bdx-","url":"https://bdx.mecatran.com/utw/ws/gtfsfeed/vehicles/bordeaux?apiKey=opendata-bordeaux-metropole-flux-gtfs-rt"},{"id":"nantes","prefix":"nte-","url":"https://proxy.transport.data.gouv.fr/resource/naolib-nantes-gtfs-rt-vehicle-position"},{"id":"lille","prefix":"lil-","url":"https://proxy.transport.data.gouv.fr/resource/ilevia-lille-gtfs-rt"}]

# --- Road traffic (Bison Futé) -----------------------------------------------
# Tipi open data — no API key. Polled ~every 6 minutes.
BISON_FUTE_URL=http://tipi.bison-fute.gouv.fr/bison-fute-ouvert/publicationsDIR/QTV-DIR/qtvDir.xml
BISON_FUTE_REF_URL=http://tipi.bison-fute.gouv.fr/bison-fute-ouvert/publicationsDIR/QTV-DIR/refDir.csv

# --- Satellites (CelesTrak) --------------------------------------------------
# No environment variables — TLE sources and 2h cache are configured in code
# (backend/src/connectors/celestrak.ts).
