# Server
PORT=3001
HOST=0.0.0.0

# OpenSky OAuth2 (https://opensky-network.org — Account → API client)
# Leave empty for anonymous access (lower quota)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# AISstream (https://aisstream.io — create API key)
AISSTREAM_API_KEY=

# Impact CO2 (https://impactco2.fr — optional API key)
IMPACT_CO2_API_KEY=

# SNCF GTFS-RT trip updates (default: transport.data.gouv.fr proxy)
# SNCF_GTFS_RT_URL=https://proxy.transport.data.gouv.fr/resource/sncf-gtfs-rt-trip-updates
# SNCF_GTFS_STATIC_URL=https://eu.ftp.opendatasoft.com/sncf/plandata/Export_OpenData_SNCF_GTFS_NewTripId.zip

# IDFM / Paris buses & metro
# Preferred: a real GTFS-RT VehiclePositions URL if you have one
# IDFM_GTFS_RT_URL=

# Default (no VP feed): community trip-updates converter + public stops index
# IDFM_TRIP_UPDATES_URL=http://gtfsidfm.clarifygdps.com/gtfs-rt-trips-idfm
# IDFM_STOPS_URL=https://data.iledefrance-mobilites.fr/api/explore/v2.1/catalog/datasets/arrets-lignes/exports/csv
